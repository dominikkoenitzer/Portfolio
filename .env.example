# GitHub token for the contributions widget and the project test counts. Server only. Required in api/github-contributions.js, optional in api/test-count.js where it only lifts the rate limit.
GITHUB_TOKEN=
# Older name for GITHUB_TOKEN, read only when GITHUB_TOKEN is unset. Server only, prefer GITHUB_TOKEN. api/github-contributions.js, api/test-count.js
VITE_GITHUB_TOKEN=

# Where the diagnostic page at /diag posts a report, a full https URL. Client, optional: without it the panel measures and shows the report but sends nothing. The URL's origin must also be added to connect-src in the Content-Security-Policy in vercel.json; the build stops when it is not (scripts/diag-csp.mjs). src/pages/Diagnostics.tsx
VITE_DIAG_ENDPOINT=
