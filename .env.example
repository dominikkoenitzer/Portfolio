# Supabase project URL for the contact form and the keepalive cron. Server only, required. api/contact.js, api/keepalive.js
SUPABASE_URL=
# Supabase service role key, needed because the tables sit behind RLS. Server only, required. api/contact.js, api/keepalive.js
SUPABASE_SERVICE_ROLE_KEY=

# Key for hashing visitor IPs in the contact rate limit. Server only, optional, plain SHA-256 without it. vite dev does not pass it to the handler. api/contact.js
CONTACT_HASH_SECRET=

# Gmail address that sends the contact notification. Server only, optional, no mail without it. api/contact.js
GMAIL_USER=
# App password for GMAIL_USER. Server only, optional, needed together with GMAIL_USER. api/contact.js
GMAIL_APP_PASSWORD=
# Address that receives contact notifications. Server only, optional, defaults to GMAIL_USER. api/contact.js
CONTACT_TO=
# Time limit for sending the notification, in ms. Server only, optional, defaults to 10000. vite dev does not pass it to the handler. api/contact.js
CONTACT_MAIL_DEADLINE_MS=

# GitHub token for the contributions widget and the project test counts. Server only. Required in api/github-contributions.js, optional in api/test-count.js where it only lifts the rate limit.
GITHUB_TOKEN=
# Older name for GITHUB_TOKEN, read only when GITHUB_TOKEN is unset. Server only, prefer GITHUB_TOKEN. api/github-contributions.js, api/test-count.js
VITE_GITHUB_TOKEN=
