  <!-- CV / Lebenslauf. Standalone documents in public/, not app routes, so the
       router-parity guard needs them in its STATIC_DOCS allowlist. Listed at
       their real paths rather than the pretty /cv and /lebenslauf URLs, which
       are 308 redirects: a sitemap entry that redirects is dropped. Their only
       inbound link is rendered by JavaScript, so without these two entries a
       crawler that does not run JS never discovers them. -->
  <url>
    <loc>https://portfolio-izanagi.vercel.app/cv/curriculum-vitae.html</loc>
    <lastmod>2026-09-27</lastmod>
    <changefreq>monthly</changefreq>
