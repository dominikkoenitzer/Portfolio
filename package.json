    "@tanstack/react-query": "^5.101.4",
    "@vercel/analytics": "^2",
    "@vercel/speed-insights": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "framer-motion": "^12.40.0",
    "lenis": "^1.3.26",
    "lucide-react": "^0.462.0",
    "ogl": "^1.0.11",
    "react": "^19",
