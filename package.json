{
  "name": "dominik-portfolio",
  "private": true,
  "version": "1.0.0",
  "description": "Personal portfolio website for Dominik Könitzer - Software Engineer",
  "type": "module",
  "author": "Dominik Könitzer",
  "license": "UNLICENSED",
  "homepage": "https://dominikkoenitzer.ch",
